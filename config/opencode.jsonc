{
  "$schema": "https://opencode.ai/config.json",

  // Local Ollama remains the installed default. scripts/oc chooses an exact
  // model per mode from config/model-routes.json and never falls back.
  "model": "ollama/qwen3.8:27b",
  "small_model": "ollama/muse-glimmer",
  "enabled_providers": ["ollama"],
  "default_agent": "fleet-plan",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": true,
  "plugin": [],
  "mcp": {},
  "instructions": [],
  "skills": {"paths": [], "urls": []},

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (mickey loopback)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (agentic code, vision) — the pinned coder",
          "tools": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "muse-glimmer": {
          "id": "muse-glimmer:latest",
          "name": "Muse Glimmer 30B (agentic, vision) — simple lane + multimodal alt",
          "tools": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "command-r:35b": {"name": "Command R 35B (long-context chat and RAG) — largest loop-safe local", "tools": true},
        "ornith-1.5:35b": {"name": "Ornith 1.5 35B (fast coder) — DIRECT/--experiment runs only, stalls in agent loops", "tools": true},
        "medgemma:27b": {"name": "MedGemma 27B (medical)", "tools": true}
      }
    }
  },

  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".envrc": "deny",
      "**/.envrc": "deny",
      ".netrc": "deny",
      "**/.netrc": "deny",
      ".npmrc": "deny",
      "**/.npmrc": "deny",
      ".pypirc": "deny",
      "**/.pypirc": "deny",
      ".git-credentials": "deny",
      "**/.git-credentials": "deny",
      "credentials.json": "deny",
      "**/credentials.json": "deny",
      "secrets.json": "deny",
      "**/secrets.json": "deny",
      "secrets.yaml": "deny",
      "**/secrets.yaml": "deny",
      "secrets.yml": "deny",
      "**/secrets.yml": "deny",
      "secrets.toml": "deny",
      "**/secrets.toml": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pfx": "deny",
      "*.ppk": "deny",
      "**/*.ppk": "deny",
      "*credentials*": "deny",
      "**/*credentials*": "deny",
      "id_rsa": "deny",
      "**/id_rsa": "deny",
      "id_dsa": "deny",
      "**/id_dsa": "deny",
      "id_ecdsa": "deny",
      "**/id_ecdsa": "deny",
      "id_ecdsa_sk": "deny",
      "**/id_ecdsa_sk": "deny",
      "id_ed25519": "deny",
      "**/id_ed25519": "deny",
      "id_ed25519_sk": "deny",
      "**/id_ed25519_sk": "deny"
    },
    "glob": "allow",
    "grep": "deny",
    "lsp": "deny",
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "bash": {
      "*": "ask",
      "bash *": "deny",
      "*/bash *": "deny",
      "sh *": "deny",
      "*/sh *": "deny",
      "zsh *": "deny",
      "*/zsh *": "deny",
      "env *": "deny",
      "*/env *": "deny",
      "command *": "deny",
      "xargs *": "deny",
      "*/xargs *": "deny",
      "gh *": "deny",
      "*/gh *": "deny",
      "hub *": "deny",
      "*/hub *": "deny",
      "git remote set-url*": "deny",
      "git config *credential*": "deny",
      "git config *pushurl*": "deny",
      "git push*": "deny",
      "git * push*": "deny",
      "/usr/bin/git push*": "deny",
      "*/git push*": "deny",
      "git reset --hard*": "deny",
      "git * reset --hard*": "deny",
      "/usr/bin/git reset --hard*": "deny",
      "*/git reset --hard*": "deny",
      "git clean*": "deny",
      "git * clean*": "deny",
      "/usr/bin/git clean*": "deny",
      "*/git clean*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "rm --recursive*": "deny",
      "rm --force*": "deny",
      "/bin/rm -rf*": "deny",
      "/bin/rm -fr*": "deny",
      "/usr/bin/rm -rf*": "deny",
      "/usr/bin/rm -fr*": "deny",
      "*/rm -rf*": "deny",
      "*/rm -fr*": "deny",
      "sudo *": "deny",
      "/usr/bin/sudo *": "deny",
      "*/sudo *": "deny",
      "*git*push*": "deny"
    }
  },

  "agent": {
    "fleet-plan": {
      "description": "Read-only implementation planning inside one catalogued clone.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "skill": "deny",
        "bash": "deny"
      },
      "tools": {
        "skill": false
      }
    },
    "fleet-review": {
      "description": "Quality review without source edits or publication.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "skill": "deny",
        "bash": {
          "*": "ask",
          "bash *": "deny",
          "*/bash *": "deny",
          "sh *": "deny",
          "*/sh *": "deny",
          "zsh *": "deny",
          "*/zsh *": "deny",
          "env *": "deny",
          "*/env *": "deny",
          "command *": "deny",
          "xargs *": "deny",
          "*/xargs *": "deny",
          "gh *": "deny",
          "*/gh *": "deny",
          "hub *": "deny",
          "*/hub *": "deny",
          "git commit*": "deny",
          "git remote set-url*": "deny",
          "git config *credential*": "deny",
          "git config *pushurl*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "/usr/bin/git push*": "deny",
          "*/git push*": "deny",
          "git reset --hard*": "deny",
          "git * reset --hard*": "deny",
          "/usr/bin/git reset --hard*": "deny",
          "*/git reset --hard*": "deny",
          "git clean*": "deny",
          "git * clean*": "deny",
          "/usr/bin/git clean*": "deny",
          "*/git clean*": "deny",
          "rm -rf*": "deny",
          "rm -fr*": "deny",
          "rm -r -f*": "deny",
          "rm -f -r*": "deny",
          "rm --recursive*": "deny",
          "rm --force*": "deny",
          "/bin/rm -rf*": "deny",
          "/bin/rm -fr*": "deny",
          "/usr/bin/rm -rf*": "deny",
          "/usr/bin/rm -fr*": "deny",
          "*/rm -rf*": "deny",
          "*/rm -fr*": "deny",
          "sudo *": "deny",
          "/usr/bin/sudo *": "deny",
          "*/sudo *": "deny",
          "*git*push*": "deny"
        }
      },
      "tools": {
        "skill": false
      }
    },
    "fleet-build": {
      "description": "Local implementation in a private run worktree; publication is held.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "skill": "deny",
        "bash": {
          "*": "ask",
          "bash *": "deny",
          "*/bash *": "deny",
          "sh *": "deny",
          "*/sh *": "deny",
          "zsh *": "deny",
          "*/zsh *": "deny",
          "env *": "deny",
          "*/env *": "deny",
          "command *": "deny",
          "xargs *": "deny",
          "*/xargs *": "deny",
          "gh *": "deny",
          "*/gh *": "deny",
          "hub *": "deny",
          "*/hub *": "deny",
          "git commit*": "ask",
          "git remote set-url*": "deny",
          "git config *credential*": "deny",
          "git config *pushurl*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "/usr/bin/git push*": "deny",
          "*/git push*": "deny",
          "git reset --hard*": "deny",
          "git * reset --hard*": "deny",
          "/usr/bin/git reset --hard*": "deny",
          "*/git reset --hard*": "deny",
          "git clean*": "deny",
          "git * clean*": "deny",
          "/usr/bin/git clean*": "deny",
          "*/git clean*": "deny",
          "rm -rf*": "deny",
          "rm -fr*": "deny",
          "rm -r -f*": "deny",
          "rm -f -r*": "deny",
          "rm --recursive*": "deny",
          "rm --force*": "deny",
          "/bin/rm -rf*": "deny",
          "/bin/rm -fr*": "deny",
          "/usr/bin/rm -rf*": "deny",
          "/usr/bin/rm -fr*": "deny",
          "*/rm -rf*": "deny",
          "*/rm -fr*": "deny",
          "sudo *": "deny",
          "/usr/bin/sudo *": "deny",
          "*/sudo *": "deny",
          "*git*push*": "deny"
        }
      },
      "tools": {
        "skill": false
      }
    }
  }
}
