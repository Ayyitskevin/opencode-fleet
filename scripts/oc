validate_versions() {
  jq -e '
    (keys == ["opencode"] or (keys | sort) == ["actionsCheckout", "opencode"]) and
    (.opencode | keys | sort) ==
      ["linuxX64Archive", "linuxX64Sha256", "version"] and
    (.opencode.version | type == "string" and
      test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and
    (.opencode.linuxX64Archive | type == "string" and length > 0) and
    (.opencode.linuxX64Sha256 | type == "string" and
      test("^[0-9a-f]{64}$"))
  ' "$versions" >/dev/null || die "OpenCode version pin failed strict validation"
}

validate_pinned_cli() {
  local expected_version expected_archive_sha actual_version actual_binary_sha

  expected_version="$(jq -r '.opencode.version' "$versions")"
  expected_archive_sha="$(jq -r '.opencode.linuxX64Sha256' "$versions")"
  [[ -f "$opencode_bin" && -x "$opencode_bin" && ! -L "$opencode_bin" ]] ||
    die "OpenCode binary must be an executable regular file"
  [[ "$(stat -c %u "$opencode_bin")" == "$(id -u)" ]] ||
    die "OpenCode binary must be owned by the current user"
  [[ -f "$cli_record" && ! -L "$cli_record" ]] ||
    die "pinned OpenCode CLI install record is missing or unsafe"
  jq -e \
    --arg version "$expected_version" \
    --arg archiveSha256 "$expected_archive_sha" \
    --arg target "$opencode_bin" '
      .schemaVersion == 1 and
      (.status // "installed") == "installed" and
      .version == $version and
      .archiveSha256 == $archiveSha256 and
      .target == $target and
      (.binarySha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      .installedType == "regular" and .mode == "700"
    ' "$cli_record" >/dev/null || die "pinned OpenCode CLI install record is invalid"
  actual_binary_sha="$(sha256sum "$opencode_bin" | cut -d' ' -f1)"
  [[ "$actual_binary_sha" == "$(jq -r '.binarySha256' "$cli_record")" ]] ||
    die "OpenCode binary digest does not match its verified install record"
  actual_version="$("$opencode_bin" --version 2>/dev/null || true)"
  [[ "$actual_version" == "$expected_version" ]] ||
    die "OpenCode binary version does not match the pin"
}

normalize_github_remote() {
  local remote="$1"
  local slug

  case "$remote" in
    git@github.com:*)
      slug="${remote#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${remote#ssh://git@github.com/}"
      ;;
    https://github.com/*)
      slug="${remote#https://github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  [[ "$slug" != *'?'* && "$slug" != *'#'* && "$slug" != *'@'* ]] || return 1
  slug="${slug%.git}"
  [[ "$slug" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    return 1
  printf '%s\n' "$slug"
}

validate_workspace_root() {
  local root="$1"
  local canonical

  [[ "$root" == /* && -d "$root" && ! -L "$root" ]] ||
    die "dedicated workspace root is missing or unsafe"
  canonical="$(realpath -e -- "$root")" ||
    die "dedicated workspace root cannot be resolved"
  [[ "$canonical" == "$root" ]] ||
    die "dedicated workspace root must be canonical and contain no symlink"
}

validate_independent_clone() {
  local path="$1"
  local expected="$2"
  local top_level common_dir remote normalized
  local -a origins push_urls

  [[ -d "$path" && ! -L "$path" ]] ||
    die "catalogued clone is missing or is a symlink"
  [[ -d "$path/.git" && ! -L "$path/.git" ]] ||
    die "catalogued clone must be an independent clone, not a linked worktree or submodule"

  top_level="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" ||
    die "catalogued path is not a Git working tree"
  top_level="$(realpath -e -- "$top_level")" ||
    die "catalogued clone top level cannot be resolved"
  [[ "$top_level" == "$path" ]] ||
    die "catalogued path is not the clone top level"

  common_dir="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die "catalogued clone Git directory cannot be resolved"
  common_dir="$(realpath -e -- "$common_dir")" ||
    die "catalogued clone Git directory cannot be resolved"
  [[ "$common_dir" == "$path/.git" ]] ||
    die "catalogued clone shares Git state with another working tree"

  mapfile -t origins < <(git -C "$path" config --get-all remote.origin.url || true)
  [[ "${#origins[@]}" -eq 1 ]] ||
    die "catalogued clone must have exactly one origin URL"
  remote="${origins[0]}"
  normalized="$(normalize_github_remote "$remote")" ||
    die "origin URL must be a credential-free GitHub SSH or HTTPS URL"
  [[ "${normalized,,}" == "${expected,,}" ]] ||
    die "origin identity does not match the repository catalog"

  mapfile -t push_urls < <(git -C "$path" config --get-all remote.origin.pushurl || true)
  for remote in "${push_urls[@]}"; do
    normalized="$(normalize_github_remote "$remote")" ||
      die "origin push URL must be a credential-free GitHub SSH or HTTPS URL"
    [[ "${normalized,,}" == "${expected,,}" ]] ||
      die "origin push identity does not match the repository catalog"
  done
}

ensure_private_directory() {
  local path="$1"
  local canonical

  [[ "$path" == /* ]] || die "state root must be absolute"
  [[ "$(realpath -m -- "$path")" == "$path" ]] ||
    die "state path contains an existing symlink or is non-canonical"
  if [[ -e "$path" ]]; then
    [[ -d "$path" && ! -L "$path" ]] || die "state root is not a private directory"
  else
    install -d -m 700 -- "$path"
  fi
  chmod 700 -- "$path"
  canonical="$(realpath -e -- "$path")" || die "state root cannot be resolved"
  [[ "$canonical" == "$path" ]] || die "state root must be canonical and contain no symlink"
}

update_run_record() {
  local temporary

  temporary="$(mktemp "$run_dir/.record.XXXXXX")"
  jq "$@" "$record_path" >"$temporary"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$record_path"
}

write_run_record() {
  local status="$1"
  local exit_code="${2:-}"
  local ended_at="${3:-}"
  local signal="${4:-}"

  if [[ -n "$exit_code" ]]; then
    update_run_record \
      --arg status "$status" \
      --argjson exitCode "$exit_code" \
      --arg endedAt "$ended_at" \
      --arg signal "$signal" \
      '.status = $status | .exitCode = $exitCode | .endedAt = $endedAt |
       if $signal == "" then . else .interruptedBy = $signal end'
  else
    update_run_record --arg status "$status" '.status = $status'
  fi
}

# What a run cost and what it produced is the whole point of keeping records
# for practice: without it there is no way to learn which local model is good
# at what. Both are additive optional fields, so schemaVersion stays 1.
record_run_outcome() {
  local duration=$(( $(date -u +%s) - run_started_epoch ))
  local numstat="" files=0 insertions=0 deletions=0

  [[ "$duration" -ge 0 ]] || duration=0
  update_run_record --argjson durationSeconds "$duration" \
    '.durationSeconds = $durationSeconds'
  [[ -n "${worktree_path:-}" && -d "${worktree_path:-}" &&
     -n "${base_commit:-}" ]] || return 0
  numstat="$(git -C "$worktree_path" diff --numstat "$base_commit" 2>/dev/null)" ||
    return 0
  while read -r added removed _; do
    [[ -n "${added:-}" ]] || continue
    files=$((files + 1))
    [[ "$added" == "-" ]] || insertions=$((insertions + added))
    [[ "$removed" == "-" ]] || deletions=$((deletions + removed))
  done <<<"$numstat"
  # Tracked edits and brand-new files are both real model output, but a diff
  # against the base commit can only see the tracked half. Counting untracked
  # files separately keeps the number honest instead of silently low.
  local untracked=0
  untracked="$(git -C "$worktree_path" ls-files --others --exclude-standard |
    grep -c '' || true)"
  update_run_record \
    --argjson files "$files" \
    --argjson insertions "$insertions" \
    --argjson deletions "$deletions" \
    --argjson untracked "${untracked:-0}" \
    '.diffstat = {files: $files, insertions: $insertions,
      deletions: $deletions, untrackedFiles: $untracked}'
}

# A run record is durable evidence, so it must never outlive the process while
# still claiming the run is in progress. The epilogue finalizes an ordinary
# return; this reconciler covers every other exit — a die between provisioning
# and execution, or a signal delivered while the model owns the terminal.
# Ctrl-C is the normal way to leave a session, so this is the common path, not
# the exceptional one.
run_record_finalized=false
run_record_signal=""
# Defaulted here, not at the model invocation: a run aborted during
# provisioning still reconciles through the same path, and an unbound variable
# under `set -u` would kill the trap that exists to finalize the record.
run_started_epoch="$(date -u +%s)"

finalize_run_record() {
  local status="$1"
  local exit_code="$2"

  [[ "$run_record_finalized" == false ]] || return 0
  run_record_finalized=true
  write_run_record "$status" "$exit_code" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_record_signal"
  record_run_outcome || true
}

reconcile_run_record() {
  local exit_code="$?"

  [[ "$run_record_finalized" == false ]] || return 0
  [[ -n "${record_path:-}" && -f "${record_path:-}" ]] || return 0
  if [[ -n "$run_record_signal" ]]; then
    finalize_run_record interrupted "$exit_code"
  else
    finalize_run_record aborted "$exit_code"
  fi
}

trap_run_signal() {
  local name="$1"
  local number="$2"

  run_record_signal="$name"
  trap - INT TERM HUP
  finalize_run_record interrupted $((128 + number))
  # Re-raise so the caller observes a genuine signal death, not a plain exit.
  kill -s "$name" -- "$BASHPID" 2>/dev/null
  exit $((128 + number))
}

# Usage needs no policy file and no dependency: it must answer even on a
# machine where nothing is installed yet.
command_name="${1:-}"
case "$command_name" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac

for dependency in jq git realpath flock install mktemp stat chmod mv date id \
  sha256sum cut sed env; do
  require_command "$dependency"
done
[[ "$(id -u)" -ne 0 ]] || die "refusing to run OpenCode as root"

# Diagnosis is dispatched before policy validation. Every validator below is a
# single fail-closed die, so validating first would make the diagnostic tool
# unreachable in exactly the broken-fleet case it exists to explain. doctor
# performs its own validation and reports every defect instead of the first.
if [[ "$command_name" == "doctor" ]]; then
  shift
  exec "$fleet_root/scripts/doctor" "$@"
fi

# Every OPENCODE_FLEET_* override redirects policy, catalog, or lane state.
# STATE_ROOT relocates the global session lock, so an override left exported in
# a shell would silently split the lane instead of serializing it; MANIFEST and
# WORKSPACE_ROOT redirect which clone is opened. Production uses the canonical
# paths only.
if [[ "${OPENCODE_FLEET_TESTING:-0}" != "1" ]]; then
  for override in OPENCODE_FLEET_MANIFEST OPENCODE_FLEET_CONFIG \
    OPENCODE_FLEET_GUARD OPENCODE_FLEET_ROUTES OPENCODE_FLEET_VERSIONS \
    OPENCODE_FLEET_BIN OPENCODE_FLEET_CLI_RECORD OPENCODE_FLEET_STATE_ROOT \
    OPENCODE_FLEET_WORKSPACE_ROOT; do
    [[ -z "${!override:-}" ]] ||
      die "policy, catalog, and lane-state overrides are test-only: $override"
  done
fi

[[ -r "$manifest" ]] || die "repository manifest is not readable"
[[ -r "$config" ]] || die "staged OpenCode config is not readable"
[[ -r "$guard" ]] || die "runtime guard is not readable"
[[ -r "$routes" ]] || die "model route policy is not readable"
[[ -r "$versions" ]] || die "OpenCode version pin is not readable"
validate_manifest
validate_routes
validate_runtime_guard
validate_staged_config
validate_versions

if [[ "$command_name" == "list" ]]; then
  jq -r '.repositories[] | [.name, .state, .risk, .githubMode] | @tsv' "$manifest"
  exit 0
fi

# Run records and preserved worktrees were write-only evidence: rich, private,
# and unreadable without hand-inspecting JSON paths. These subcommands are
# read-only over lane-owned state and add no authority — no run is started, no
# clone is touched, and nothing is ever pushed.
runs_root="$state_root/runs"

resolve_run_record() {
  local candidate="${1:-}"

  [[ -n "$candidate" ]] || die "a run ID is required"
  [[ "$candidate" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "run ID contains unsafe characters"
  run_dir="$runs_root/$candidate"
  record_path="$run_dir/record.json"
  [[ -d "$run_dir" && ! -L "$run_dir" ]] || die "no such run: $candidate"
  [[ -f "$record_path" && ! -L "$record_path" ]] ||
    die "run has no readable record: $candidate"
}

collect_run_records() {
  local record
  run_records=()
  [[ -d "$runs_root" ]] || return 0
  for record in "$runs_root"/*/record.json; do
    [[ -f "$record" && ! -L "$record" ]] || continue
    run_records+=("$record")
  done
}

case "$command_name" in
  runs)
    shift
    run_filter="${1:-}"
    collect_run_records
    [[ "${#run_records[@]}" -gt 0 ]] || exit 0
    run_rows="$(jq -r --arg filter "${run_filter,,}" '
      select($filter == "" or (.repository | ascii_downcase) == $filter) |
      [.runId, .repository, .mode, .model, .status,
       (.durationSeconds // "-" | tostring),
       (if .diffstat
          then "+\(.diffstat.insertions)/-\(.diffstat.deletions)"
          else "-" end),
       .createdAt] | @tsv
    ' "${run_records[@]}" | sort)"
    # A filter that matches nothing prints nothing, header included: an empty
    # result must stay empty for anything reading this.
    [[ -n "$run_rows" ]] || exit 0
    printf 'RUN\tREPOSITORY\tMODE\tMODEL\tSTATUS\tSECONDS\tDIFF\tCREATED\n'
    printf '%s\n' "$run_rows"
    exit 0
    ;;
  show)
    shift
    resolve_run_record "${1:-}"
    jq . "$record_path"
    exit 0
    ;;
  diff)
    shift
    resolve_run_record "${1:-}"
    run_worktree="$(jq -r '.worktreePath // ""' "$record_path")"
    run_base="$(jq -r '.baseCommit // ""' "$record_path")"
    [[ -n "$run_worktree" ]] ||
      die "only build runs have a worktree to diff"
    [[ -d "$run_worktree" ]] ||
      die "the run worktree is no longer present"
    [[ -n "$run_base" ]] || die "run record has no base commit"
    exec git -C "$run_worktree" diff "$run_base"
    ;;
  note)
    shift
    resolve_run_record "${1:-}"
    shift
    note_text="$*"
    [[ -n "$note_text" ]] || die "a note requires text"
    note_status="$(jq -r '.status' "$record_path")"
    [[ "$note_status" != "provisioning" && "$note_status" != "active" ]] ||
      die "refusing to annotate a run that is still in progress"
    update_run_record \
      --arg note "$note_text" \
      --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '.notes = ((.notes // []) + [{at: $at, note: $note}])'
    exit 0
    ;;
  stats)
    shift
    stats_key="model"
    case "${1:-}" in
      ""|--model) ;;
      --repo) stats_key="repository" ;;
      *) die "unknown argument: $1" ;;
    esac
    collect_run_records
    [[ "${#run_records[@]}" -gt 0 ]] || { printf 'no runs recorded\n'; exit 0; }
    printf '%s\tRUNS\tCOMPLETED\tMEAN_SECONDS\tINSERTIONS\tDELETIONS\n' \
      "${stats_key^^}"
    jq -s -r --arg key "$stats_key" '
      group_by(.[$key])[] |
      [.[0][$key], length,
       (map(select(.status == "completed")) | length),
       ((map(.durationSeconds // 0) | add) / length | floor),
       (map(.diffstat.insertions // 0) | add),
       (map(.diffstat.deletions // 0) | add)] | @tsv
    ' "${run_records[@]}"
    exit 0
    ;;
esac

repository_query="$command_name"
shift
mode="plan"
if [[ "${1:-}" =~ ^(plan|build|review)$ ]]; then
  mode="$1"
  shift
fi

use_ceiling=false
use_cloud=false
experiment_model=""
dry_run=false
while (($#)); do
  case "$1" in
    --ceiling)
      use_ceiling=true
      ;;
    --cloud)
      use_cloud=true
      ;;
    --experiment)
      shift
      (($#)) || die "--experiment requires an ollama/<model> argument"
      experiment_model="$1"
      ;;
    --experiment=*)
      experiment_model="${1#--experiment=}"
      ;;
    --dry-run)
      dry_run=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
  shift
done

selected_routes=0
[[ "$use_ceiling" != true ]] || selected_routes=$((selected_routes + 1))
[[ "$use_cloud" != true ]] || selected_routes=$((selected_routes + 1))
[[ -z "$experiment_model" ]] || selected_routes=$((selected_routes + 1))
[[ "$selected_routes" -le 1 ]] ||
  die "--ceiling, --cloud, and --experiment are mutually exclusive"

matches="$(
  jq -c --arg query "${repository_query,,}" '
    [.repositories[] |
      select((.name | ascii_downcase) == $query or
             (.fullName | ascii_downcase) == $query)]
  ' "$manifest"
)"
match_count="$(jq 'length' <<<"$matches")"
if [[ "$match_count" -eq 0 ]]; then
  die "repository is not catalogued"
elif [[ "$match_count" -ne 1 ]]; then
  die "repository query is ambiguous"
fi

entry="$(jq -c '.[0]' <<<"$matches")"
repository_name="$(jq -r '.name' <<<"$entry")"
repository_full_name="$(jq -r '.fullName' <<<"$entry")"
repository_state="$(jq -r '.state' <<<"$entry")"
repository_risk="$(jq -r '.risk' <<<"$entry")"
default_branch="$(jq -r '.defaultBranch' <<<"$entry")"
[[ "$repository_state" == "active" ]] ||
  die "repository is a registered placeholder and has no clone"
git check-ref-format "refs/heads/$default_branch" >/dev/null 2>&1 ||
  die "catalogued default branch is not a valid Git branch"

workspace_root="${OPENCODE_FLEET_WORKSPACE_ROOT:-$(jq -r '.workspaceRoot' "$manifest")}"
validate_workspace_root "$workspace_root"
repository_path="$workspace_root/$repository_name"
[[ "$(realpath -m -- "$repository_path")" == "$repository_path" ]] ||
  die "catalogued clone path is not canonical"
validate_independent_clone "$repository_path" "$repository_full_name"

agent="$(jq -r --arg mode "$mode" '.routes[$mode].agent' "$routes")"
model="$(jq -r --arg mode "$mode" '.routes[$mode].model' "$routes")"
cost_class="$(jq -r --arg mode "$mode" '.routes[$mode].costClass' "$routes")"
if [[ "$use_ceiling" == true ]]; then
  model="$(jq -r '.ceiling.model' "$routes")"
  cost_class="$(jq -r '.ceiling.costClass' "$routes")"
elif [[ -n "$experiment_model" ]]; then
  # Practising with another local model is an explicit, allowlisted escalation
  # in the same shape as --ceiling and --cloud: never an environment override,
  # never a fallback, and never off the pinned loopback provider.
  jq -e --arg model "$experiment_model" \
    '(.localExperiments // []) | index($model) != null' "$routes" >/dev/null ||
    die "requested model is not in the local experiment allowlist"
  sed '/^[[:space:]]*\/\//d' "$config" |
    jq -e --arg model "${experiment_model#ollama/}" \
      '.provider.ollama.models[$model] != null' >/dev/null ||
    die "experiment model is absent from the staged provider catalog"
  model="$experiment_model"
  cost_class="local-experiment"
elif [[ "$use_cloud" == true ]]; then
  [[ "$(jq -r '.cloud.enabled' "$routes")" == "true" ]] ||
    die "cloud routing is disabled by policy"
  model="${OPENCODE_FLEET_CLOUD_MODEL:-}"
  [[ -n "$model" && "$model" != ollama/* ]] ||
    die "--cloud requires a non-Ollama OPENCODE_FLEET_CLOUD_MODEL"
  jq -e --arg model "$model" '.cloud.allowlist | index($model) != null' \
    "$routes" >/dev/null ||
    die "requested cloud model is not explicitly allowlisted"
  cost_class="paid-cloud"
fi

dirty=false
status_output="$(git -C "$repository_path" status --porcelain=v1 --untracked-files=all)" ||
  die "cannot determine clone cleanliness"
[[ -z "$status_output" ]] || dirty=true
current_branch="$(git -C "$repository_path" symbolic-ref --quiet --short HEAD || true)"
base_commit="$(git -C "$repository_path" rev-parse --verify HEAD 2>/dev/null)" ||
  die "catalogued clone has no valid HEAD"

if [[ "$mode" == "build" ]]; then
  [[ "$dirty" == false ]] ||
    die "build requires a clean dedicated clone"
  [[ "$current_branch" == "$default_branch" ]] ||
    die "build requires the catalogued default branch"
fi

if [[ "$dry_run" == true ]]; then
  jq -n \
    --arg repository "$repository_name" \
    --arg fullName "$repository_full_name" \
    --arg path "$repository_path" \
    --arg mode "$mode" \
    --arg agent "$agent" \
    --arg model "$model" \
    --arg costClass "$cost_class" \
    --arg risk "$repository_risk" \
    --arg currentBranch "$current_branch" \
    --arg defaultBranch "$default_branch" \
    --arg baseCommit "$base_commit" \
    --argjson dirty "$dirty" \
    '{
      repository: $repository,
      fullName: $fullName,
      sourcePath: $path,
      executionPath: (if $mode == "build" then "private-run-worktree" else $path end),
      mode: $mode,
      agent: $agent,
      model: $model,
      costClass: $costClass,
      risk: $risk,
      currentBranch: $currentBranch,
      defaultBranch: $defaultBranch,
      baseCommit: $baseCommit,
      dirty: $dirty
    }'
  exit 0
fi

validate_pinned_cli

ensure_private_directory "$state_root"
ensure_private_directory "$state_root/runs"
ensure_private_directory "$state_root/worktrees"
lock_path="$state_root/session.lock"
[[ ! -L "$lock_path" ]] || die "global session lock must not be a symlink"
exec 9>"$lock_path"
chmod 600 "$lock_path"
flock -n 9 || die "another OpenCode fleet session owns the local lane"

run_id="${OPENCODE_FLEET_RUN_ID:-}"
if [[ -n "$run_id" && "${OPENCODE_FLEET_TESTING:-0}" != "1" ]]; then
  die "fixed run IDs are allowed only in test mode"
fi
if [[ -z "$run_id" ]]; then
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$BASHPID-$RANDOM"
fi
[[ "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
  die "run ID contains unsafe characters"

run_dir="$state_root/runs/$run_id"
record_path="$run_dir/record.json"
[[ ! -e "$run_dir" && ! -L "$run_dir" ]] || die "run ID already exists"
install -d -m 700 "$run_dir"

execution_path="$repository_path"
worktree_path=""
run_branch=""
if [[ "$mode" == "build" ]]; then
  worktree_parent="$state_root/worktrees/${repository_name,,}"
  ensure_private_directory "$worktree_parent"
  worktree_path="$worktree_parent/$run_id"
  run_branch="opencode/build/$run_id"
  execution_path="$worktree_path"
fi

created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
record_temporary="$(mktemp "$run_dir/.record.XXXXXX")"
jq -n \
  --arg runId "$run_id" \
  --arg repository "$repository_name" \
  --arg fullName "$repository_full_name" \
  --arg mode "$mode" \
  --arg agent "$agent" \
  --arg model "$model" \
  --arg costClass "$cost_class" \
  --arg sourcePath "$repository_path" \
  --arg executionPath "$execution_path" \
  --arg worktreePath "$worktree_path" \
  --arg baseCommit "$base_commit" \
  --arg baseBranch "$current_branch" \
  --arg runBranch "$run_branch" \
  --arg createdAt "$created_at" \
  '{
    schemaVersion: 1,
    runId: $runId,
    repository: $repository,
    fullName: $fullName,
    mode: $mode,
    agent: $agent,
    model: $model,
    costClass: $costClass,
    sourcePath: $sourcePath,
    executionPath: $executionPath,
    worktreePath: $worktreePath,
    baseCommit: $baseCommit,
    baseBranch: $baseBranch,
    runBranch: $runBranch,
    createdAt: $createdAt,
    status: "provisioning"
  }' >"$record_temporary"
chmod 600 "$record_temporary"
mv -f -- "$record_temporary" "$record_path"

# The record now exists, so every later exit path has something to reconcile.
trap 'trap_run_signal INT 2' INT
trap 'trap_run_signal TERM 15' TERM
trap 'trap_run_signal HUP 1' HUP
trap reconcile_run_record EXIT

if [[ "$mode" == "build" ]]; then
  [[ ! -e "$worktree_path" && ! -L "$worktree_path" ]] ||
    die "private run worktree already exists"
  git check-ref-format "refs/heads/$run_branch" >/dev/null 2>&1 ||
    die "generated run branch is invalid"
fi

if [[ "$mode" == "build" ]]; then
  if ! git -C "$repository_path" worktree add --quiet \
    -b "$run_branch" "$worktree_path" "$base_commit"; then
    finalize_run_record "provision-failed" 1
    die "private run worktree provisioning failed"
  fi
fi
write_run_record "active"

runtime_home="$run_dir/runtime-home"
runtime_config_dir="$runtime_home/.config/opencode"
install -d -m 700 "$runtime_home" "$runtime_home/.config" \
  "$runtime_home/.cache" "$runtime_home/.local/share" \
  "$runtime_home/.local/state" "$runtime_config_dir"
# A denylist of provider credentials cannot be complete: it is only ever as
# current as the day it was written. The explicit names below document the
# providers known today; the pattern sweep closes the same door for every
# credential-shaped variable that exists in this environment, including ones
# from providers that did not exist when this was written.
provider_credential_names=(
  AI21_API_KEY ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL
  AWS_ACCESS_KEY_ID AWS_CONFIG_FILE AWS_CONTAINER_CREDENTIALS_FULL_URI
  AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_DEFAULT_PROFILE AWS_PROFILE
  AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SHARED_CREDENTIALS_FILE
  AWS_WEB_IDENTITY_TOKEN_FILE AZURE_API_KEY AZURE_CLIENT_ID
  AZURE_CLIENT_SECRET AZURE_OPENAI_API_KEY AZURE_OPENAI_ENDPOINT
  AZURE_TENANT_ID BEDROCK_API_KEY CEREBRAS_API_KEY COHERE_API_KEY
  DASHSCOPE_API_KEY DATABRICKS_TOKEN DEEPINFRA_API_KEY DEEPSEEK_API_KEY
  FIREWORKS_API_KEY GEMINI_API_KEY GOOGLE_API_KEY
  GOOGLE_APPLICATION_CREDENTIALS GOOGLE_GENERATIVE_AI_API_KEY GROQ_API_KEY
  HF_TOKEN HUGGINGFACE_API_KEY MISTRAL_API_KEY MOONSHOT_API_KEY
  NVIDIA_API_KEY OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORG_ID OPENAI_PROJECT
  OPENCODE_API_KEY OPENROUTER_API_KEY PERPLEXITY_API_KEY REPLICATE_API_TOKEN
  TOGETHER_API_KEY VERTEXAI_PROJECT XAI_API_KEY
)

provider_credential_patterns=(
  '*_ACCESS_KEY' '*_ACCESS_KEY_ID' '*_APIKEY' '*_API_KEY' '*_AUTH_TOKEN'
  '*_CREDENTIALS' '*_CREDENTIALS_FILE' '*_PASSWORD' '*_PRIVATE_KEY'
  '*_SECRET' '*_SECRET_ACCESS_KEY' '*_SECRET_KEY' '*_SESSION_TOKEN' '*_TOKEN'
)

# The explicit cloud lane enables exactly one provider, so exactly that
# provider's credentials survive. An allowlisted model whose provider has no
# declared mapping fails closed rather than falling back to passing everything.
cloud_provider_credentials() {
  case "$1" in
    anthropic) printf '%s\n' ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ;;
    openai) printf '%s\n' OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORG_ID \
      OPENAI_PROJECT ;;
    opencode) printf '%s\n' OPENCODE_API_KEY ;;
    openrouter) printf '%s\n' OPENROUTER_API_KEY ;;
    google) printf '%s\n' GEMINI_API_KEY GOOGLE_API_KEY \
      GOOGLE_GENERATIVE_AI_API_KEY ;;
    groq) printf '%s\n' GROQ_API_KEY ;;
    mistral) printf '%s\n' MISTRAL_API_KEY ;;
    deepseek) printf '%s\n' DEEPSEEK_API_KEY ;;
    xai) printf '%s\n' XAI_API_KEY ;;
    *) return 1 ;;
  esac
}

declare -A sanitized_credentials=()
for credential_name in "${provider_credential_names[@]}"; do
  sanitized_credentials["$credential_name"]=1
done
while IFS='=' read -r -d '' credential_name _; do
  [[ "$credential_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  for credential_pattern in "${provider_credential_patterns[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$credential_name" == $credential_pattern ]]; then
      sanitized_credentials["$credential_name"]=1
      break
    fi
  done
done < <(env -0)

if [[ "$use_cloud" == true ]]; then
  cloud_provider="${model%%/*}"
  [[ "$cloud_provider" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "allowlisted cloud model has an invalid provider identifier"
  mapfile -t cloud_credentials < <(cloud_provider_credentials "$cloud_provider")
  [[ "${#cloud_credentials[@]}" -gt 0 ]] ||
    die "allowlisted cloud provider has no declared credential mapping"
  for credential_name in "${cloud_credentials[@]}"; do
    unset "sanitized_credentials[$credential_name]"
  done
  guard_content="$(jq -c --arg provider "$cloud_provider" \
    '.enabled_providers = [$provider]' "$guard")"
else
  guard_content="$(jq -c '.enabled_providers = ["ollama"]' "$guard")"
fi

provider_env_sanitizers=()
for credential_name in "${!sanitized_credentials[@]}"; do
  provider_env_sanitizers+=(-u "$credential_name")
done

printf 'run:        %s\n' "$run_id"
printf 'repository: %s (%s)\n' "$repository_name" "$repository_risk"
printf 'mode:       %s\n' "$mode"
printf 'model:      %s\n' "$model"
printf 'cost:       %s\n' "$cost_class"
printf 'source:     %s\n' "$repository_path"
printf 'execution:  %s\n' "$execution_path"
printf 'record:     %s\n' "$record_path"

run_started_epoch="$(date -u +%s)"
set +e
env \
  "${provider_env_sanitizers[@]}" \
  -u OPENCODE_PERMISSION \
  -u OPENCODE_PLUGIN_META_FILE \
  -u SSH_AUTH_SOCK \
  -u GH_TOKEN \
  -u GITHUB_TOKEN \
  -u GH_ENTERPRISE_TOKEN \
  -u GITHUB_ENTERPRISE_TOKEN \
  -u GITLAB_TOKEN \
  -u GITLAB_ACCESS_TOKEN \
  HOME="$runtime_home" \
  XDG_CONFIG_HOME="$runtime_home/.config" \
  XDG_CACHE_HOME="$runtime_home/.cache" \
  XDG_DATA_HOME="$runtime_home/.local/share" \
  XDG_STATE_HOME="$runtime_home/.local/state" \
  OPENCODE_CONFIG="$config" \
  OPENCODE_CONFIG_DIR="$runtime_config_dir" \
  OPENCODE_CONFIG_CONTENT="$guard_content" \
  OPENCODE_PURE=1 \
  OPENCODE_DISABLE_PROJECT_CONFIG=1 \
  OPENCODE_DISABLE_EXTERNAL_SKILLS=1 \
  OPENCODE_DISABLE_CLAUDE_CODE=1 \
  OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
  OPENCODE_DISABLE_AUTOUPDATE=1 \
  OPENCODE_DISABLE_MODELS_FETCH=1 \
  GIT_TERMINAL_PROMPT=0 \
  GCM_INTERACTIVE=never \
  GIT_ASKPASS=/bin/false \
  SSH_ASKPASS=/bin/false \
  GIT_SSH=/bin/false \
  GIT_SSH_COMMAND=/bin/false \
  GIT_CONFIG_NOSYSTEM=1 \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_CONFIG_COUNT=4 \
  GIT_CONFIG_KEY_0=credential.helper \
  GIT_CONFIG_VALUE_0= \
  GIT_CONFIG_KEY_1=credential.interactive \
  GIT_CONFIG_VALUE_1=never \
  GIT_CONFIG_KEY_2=core.askPass \
  GIT_CONFIG_VALUE_2=/bin/false \
  GIT_CONFIG_KEY_3=remote.origin.pushurl \
  GIT_CONFIG_VALUE_3=disabled://opencode-fleet-local \
  "$opencode_bin" --pure "$execution_path" --agent "$agent" --model "$model"
exit_code=$?
set -e

if [[ "$exit_code" -eq 0 ]]; then
  finalize_run_record "completed" "$exit_code"
else
  finalize_run_record "failed" "$exit_code"
fi
exit "$exit_code"
